{
  "name": "kelimeki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kelimeki — 2 ya da 4 kişilik, köşelerden başlayan stratejik Türkçe kelime oyunu.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "build:dict": "node scripts/build-dictionary.mjs",
    "augment-dictionary": "node scripts/augment-dictionary.mjs",
    "generate-golden-vectors": "esbuild scripts/generate-golden-vectors.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/golden-gen.mjs --log-level=error && node node_modules/.cache/kelimeki/golden-gen.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-meanings-db": "node scripts/generate-meanings-db.mjs",
    "generate-logo-paths": "node scripts/generate-logo-paths.mjs",
    "generate-klig-paths": "node scripts/generate-klig-paths.mjs",
    "verify-cloud-save-mirror": "esbuild scripts/verify-cloud-save-mirror.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-cloud-save-mirror.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-cloud-save-mirror.mjs",
    "verify-fetch-my-games": "node scripts/run-verify-fetch-my-games.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "opentype.js": "^2.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
