{
  "name": "kelimeki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kelimeki — 2 ya da 4 kişilik, köşelerden başlayan stratejik Türkçe kelime oyunu.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "build:dict": "node scripts/build-dictionary.mjs",
    "augment-dictionary": "node scripts/augment-dictionary.mjs",
    "generate-golden-vectors": "esbuild scripts/generate-golden-vectors.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/golden-gen.mjs --log-level=error && node node_modules/.cache/kelimeki/golden-gen.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-og-image": "node scripts/generate-og-image.mjs",
    "generate-meanings-db": "node scripts/generate-meanings-db.mjs",
    "generate-logo-paths": "node scripts/generate-logo-paths.mjs",
    "generate-klig-paths": "node scripts/generate-klig-paths.mjs",
    "check-doc-size": "node scripts/check-doc-size.mjs",
    "verify-recent-game-avatars": "esbuild scripts/verify-recent-game-avatars.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-recent-game-avatars.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-recent-game-avatars.mjs",
    "verify-game-list-order": "esbuild scripts/verify-game-list-order.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-game-list-order.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-game-list-order.mjs",
    "verify-head-to-head": "esbuild scripts/verify-head-to-head.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-head-to-head.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-head-to-head.mjs",
    "verify-draft-rescue": "esbuild scripts/verify-draft-rescue.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-draft-rescue.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-draft-rescue.mjs",
    "verify-cloud-save-mirror": "esbuild scripts/verify-cloud-save-mirror.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-cloud-save-mirror.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-cloud-save-mirror.mjs",
    "verify-fetch-my-games": "node scripts/run-verify-fetch-my-games.mjs",
    "verify-error-reporting": "node scripts/run-verify-error-reporting.mjs",
    "verify-live-games-load": "node scripts/run-verify-live-games-load.mjs",
    "verify-remaining-tiles": "esbuild scripts/verify-remaining-tiles.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-remaining-tiles.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-remaining-tiles.mjs",
    "verify-push-payload": "esbuild scripts/verify-push-payload.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-push-payload.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-push-payload.mjs",
    "generate-demo-board-dart": "esbuild scripts/generate-demo-board-dart.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/generate-demo-board-dart.mjs --log-level=error && node node_modules/.cache/kelimeki/generate-demo-board-dart.mjs",
    "generate-reel": "node scripts/reel/build.mjs",
    "generate-fb-cover": "node scripts/kapak/build.mjs",
    "generate-play-assets": "node scripts/play-store/build.mjs",
    "verify-demo-board": "esbuild scripts/verify-demo-board.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/kelimeki/verify-demo-board.mjs --log-level=error && node node_modules/.cache/kelimeki/verify-demo-board.mjs",
    "generate-initial-main-view-golden": "node scripts/run-generate-initial-main-view-golden.mjs",
    "verify-league-tiers": "node scripts/verify-league-tiers.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "opentype.js": "^2.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  }
}
