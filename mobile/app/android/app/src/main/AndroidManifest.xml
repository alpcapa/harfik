<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ⚠ BU SATIRI SİLME. Uygulamanın sunucuyla konuşan HER özelliği buna
         bağlı: giriş/kayıt, Canlı oyun, k-lig, sohbet, telemetri.

         Flutter'ın şablonu INTERNET'i YALNIZCA `debug/` ve `profile/`
         manifestlerine koyuyor (hot reload için); `main/` release derlemesine
         girer ve orada yoktu. Kullandığımız eklentilerin HİÇBİRİ de eklemiyor
         (`connectivity_plus` yalnız ACCESS_NETWORK_STATE veriyor) — yani
         release APK internetsiz çıkıyordu.

         BULUNDU 24 Ağustos 2026, ilk gerçek cihaz kurulumunda: giriş denemesi
         `Failed host lookup: '<ref>.supabase.co' (No address associated with
         hostname, errno = 7)` veriyordu. Hata DNS'e benziyor ama sebebi ağ
         değil izin: izin yokken Android'in çözümleyicisi de kapalı.

         Neden bugüne kadar görünmedi: cihaz testleri GitHub Pages'teki Flutter
         WEB derlemesinde yapılıyordu (orada Android izin modeli yok) ve debug
         APK yukarıdaki debug manifestinden izni otomatik alıyor. share_plus/
         iPad vakasıyla (Parça 122) aynı sınıf: web derlemesi native-only
         kusurları yapısal olarak gizliyor.

         Regresyonu CI'daki "İnternet izni birleşmiş manifeste girdi mi"
         adımı zorluyor — kaynağı değil DERLENMİŞ çıktıyı okuyor, çünkü izin
         buraya yazılmadan da bir eklentiden gelebilir ya da tam tersi. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Kelimeki"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links: e-posta/paylaşım linkleri (kelimeki.com) kurulu
                 uygulamayı açsın. autoVerify sitenin
                 /.well-known/assetlinks.json yayınlamasını gerektiriyor;
                 o dosya 25 Ağustos 2026'da YAYINLANDI (Play'in ürettiği imza
                 parmak iziyle — marketing/play-store/console-formlari.md §6.6).
                 Doğrulama YALNIZCA Play'den kurulan derlemede geçer: CI'nın
                 debug-imzalı .apk'sı farklı bir anahtarla imzalandığından
                 orada linkler tarayıcıda açılmaya devam eder. -->
            <intent-filter
                android:autoVerify="true">
                <action
                    android:name="android.intent.action.VIEW"/>
                <category
                    android:name="android.intent.category.DEFAULT"/>
                <category
                    android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="kelimeki.com"/>
            </intent-filter>
            <!-- Custom şema (kelimeki://): Supabase auth dönüş linkleri —
                 bugün şifre sıfırlama (kelimeki://reset), ileride davet gibi
                 diğer dönüşler. App Links'in aksine doğrulama (assetlinks)
                 GEREKTİRMEZ, imzalama anahtarı beklemeden çalışır; host
                 kısıtlanmadı ki gelecekteki kelimeki://... linkleri de aynı
                 filtreden geçsin. supabase_flutter gelen URI'yi app_links
                 üzerinden kendisi yakalar (auth parametresi taşımayan URI'lere
                 dokunmaz — bkz. mobile/CLAUDE.md, şifre sıfırlama parçası). -->
            <intent-filter>
                <action
                    android:name="android.intent.action.VIEW"/>
                <category
                    android:name="android.intent.category.DEFAULT"/>
                <category
                    android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="kelimeki"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
